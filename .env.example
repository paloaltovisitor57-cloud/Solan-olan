# Copy to .env and fill in. Never commit .env.
# All variables are optional unless the referenced provider is enabled in the YAML config.

# --- Solana RPC (HTTP + WebSocket). Public mainnet works but is rate limited.
# Helius / QuickNode / Triton URLs include the API key in the URL.
SNIPER_PROVIDERS__SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SNIPER_PROVIDERS__SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# --- Helius (optional; enables DAS holder counts + faster WS). Key only, no secret.
SNIPER_PROVIDERS__HELIUS_API_KEY=

# --- Jupiter (optional key for api.jup.ag; lite-api.jup.ag works without a key)
SNIPER_PROVIDERS__JUPITER_API_KEY=

# --- Wallet PUBLIC key only. Used to prepare UNSIGNED swap transactions in signal mode.
SNIPER_PROVIDERS__WALLET_PUBLIC_KEY=

# --- Autonomous mode (the bot signs and broadcasts from its own hot wallet).
# `solana-sniper wallet create` and `solana-sniper arm` fill these in; the value is a PATH to
# the key file, never the key. Keep the file 0600. Never put your main wallet's key here.
SNIPER_WALLET__KEY_FILE=
SNIPER_AUTONOMY__ENABLED=false
SNIPER_AUTONOMY__ACKNOWLEDGE_REAL_MONEY=false
SNIPER_AUTONOMY__MAX_TOTAL_LOSS_SOL=
SNIPER_AUTONOMY__MAX_TRADE_SOL=0.05
SNIPER_AUTONOMY__MAX_DAILY_SPEND_SOL=0.5
# Optional dedicated RPC for sends (Helius/QuickNode); defaults to SNIPER_PROVIDERS__SOLANA_RPC_URL
SNIPER_AUTONOMY__SEND_RPC_URL=

# --- Alerts (optional)
SNIPER_ALERTS__DISCORD_WEBHOOK_URL=
SNIPER_ALERTS__TELEGRAM_BOT_TOKEN=
SNIPER_ALERTS__TELEGRAM_CHAT_ID=
